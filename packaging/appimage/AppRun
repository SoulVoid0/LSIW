#!/bin/sh
# Entry point of the LSIW AppImage.
#
#   ./LSIW-x86_64.AppImage                 opens LSIW Control (settings app)
#   ./LSIW-x86_64.AppImage ARGS...         runs `lsiw ARGS...`
#   ./LSIW-x86_64.AppImage control [ARGS]  opens LSIW Control
#   ./LSIW-x86_64.AppImage lsiw ARGS...    runs `lsiw ARGS...` (any first word)
#
# A link to the AppImage named `lsiw` always runs the command, and one
# named `lsiw-control` always opens the settings app, so
#   ln -s ~/Applications/LSIW-x86_64.AppImage ~/.local/bin/lsiw
# gives a normal `lsiw` command.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

HERE=$(dirname "$(readlink -f "$0")")
APPDIR=${APPDIR:-$HERE}
export APPDIR

gui() {
    # LSIW Control and its bundled GTK need a recent C library; lsiw
    # itself runs on older systems too.
    need=$(cat "$APPDIR/usr/share/doc/lsiw/gui-glibc" 2>/dev/null || echo 2.17)
    have=$(getconf GNU_LIBC_VERSION 2>/dev/null | sed 's/^glibc //')
    if [ -n "$have" ] && [ "$(printf '%s\n%s\n' "$need" "$have" | sort -t. -k1,1n -k2,2n | head -n 1)" != "$need" ]; then
        echo "LSIW Control needs glibc $need or newer; this system has $have." >&2
        echo "The lsiw command works here: run this AppImage with arguments (--help)." >&2
        exit 1
    fi
    exec "$APPDIR/usr/bin/lsiw-control" "$@"
}
cli() { exec "$APPDIR/usr/bin/lsiw" "$@"; }

case $(basename "${ARGV0:-$0}") in
    lsiw-control*) gui "$@" ;;
    lsiw) cli "$@" ;;
esac

case ${1-} in
    control|lsiw-control|--control) shift; gui "$@" ;;
    lsiw) shift; cli "$@" ;;
    "")
        if [ -n "${WAYLAND_DISPLAY-}${DISPLAY-}" ]; then gui; fi
        cli --help ;;
    *) cli "$@" ;;
esac
